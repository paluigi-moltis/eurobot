# llm-pycascade configuration
# Mount this file at /app/config/llm-pycascade.toml inside the container.
# API keys are injected via environment variables (.env).

[providers.together]
type = "openai"
# API key is read from the env var named below (no secrets in this file)
api_key_env = "TOGETHER_API_KEY"
base_url = "https://api.together.xyz/v1"

[providers.groq]
type = "openai"
api_key_env = "GROQ_API_KEY"
base_url = "https://api.groq.com/openai/v1"


# Cascade: ordered provider/model entries for failover
# Edit models to your preferred providers. First entry is tried first.
[cascades.default]
entries = [
    { provider = "together", model = "deepseek-ai/DeepSeek-V4-Flash-0731" },
    { provider = "together", model = "Prism-ML/Ternary-Bonsai-27B" },
    { provider = "groq",     model = "qwen/qwen3.6-27b" },
    { provider = "groq",     model = "openai/gpt-oss-120b" },
]

# API keys and endpoint configuration for eurobot
#
# LLM provider keys (referenced by config/llm-pycascade.toml)
OPENAI_API_KEY=replace_me
ANTHROPIC_API_KEY=replace_me
GEMINI_API_KEY=replace_me
#
# zzboard publishing endpoint
ZZBOARD_API_TOKEN=replace_me
ZZBOARD_API_ENDPOINT=https://roll.by.gg8.eu/api/posts
#
# Optional: override default config/data paths inside container
EUROBOT_CONFIG_DIR=/app/config
EUROBOT_DATA_DIR=/app/data
